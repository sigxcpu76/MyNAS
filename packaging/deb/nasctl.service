[Unit]
Description=nasctl Unified Storage & Virtualization Platform
Documentation=https://github.com/sigxcpu/nas
After=network.target network-online.target zfs-mount.service docker.service libvirtd.service
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/root
EnvironmentFile=-/etc/default/nasctl
ExecStart=/usr/bin/nasctl start $NASCTL_OPTS
Restart=always
RestartSec=3s
LimitNOFILE=65536
LimitNPROC=65536

[Install]
WantedBy=multi-user.target
